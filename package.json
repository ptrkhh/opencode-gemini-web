{
  "name": "opencode-gemini-web",
  "version": "1.1.0",
  "description": "Use your signed-in Gemini web account's models from OpenCode through a local adapter",
  "type": "module",
  "exports": {
    ".": "./plugin.mjs"
  },
  "bin": {
    "opencode-gemini-web": "cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test",
    "login": "node login.mjs",
    "sync-models": "node sync-models.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2",
    "playwright-core": "1.65.1"
  }
}
